# ── 필수 (Vercel에 배포할 때) ─────────────────────────────
# 로그인 쿠키 서명용 비밀값. 아무 긴 랜덤 문자열(32자 이상)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 강사(관리자) 로그인 비밀번호. 로그인 화면에서 기수 = "강사(관리자)", 아이디 = admin
ADMIN_PASSWORD=change-me

# ── 데이터베이스 ───────────────────────────────────────────
# Vercel > Storage > Neon(Postgres) 연결 시 자동으로 들어갑니다.
# 비워두면 로컬 개발용 내장 DB(.data/pglite)를 사용합니다.
DATABASE_URL=

# ── 파일 저장소 (이미지·동영상) ────────────────────────────
# Vercel > Storage > Blob 연결 시 자동으로 들어갑니다.
# 비워두면 로컬 폴더(.data/uploads)에 저장합니다.
BLOB_READ_WRITE_TOKEN=

# ── AI 기능 (선택) ─────────────────────────────────────────
# 넣으면 'AI 평가 / AI 초안' 버튼이 직접 동작합니다.
# 비워두면 '프롬프트 복사' 모드로 동작합니다(학습자가 자기 챗봇에 붙여넣기).
ANTHROPIC_API_KEY=
# 사용할 모델 (기본: claude-opus-5-5)
AI_MODEL=claude-opus-5-5
